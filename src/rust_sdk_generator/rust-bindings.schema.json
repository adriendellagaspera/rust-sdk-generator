{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust bindings consumed by rust-sdk-compiler",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "structs",
    "enums",
    "aliases",
    "operations",
    "symbol_paths",
    "binding"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "structs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type"],
          "properties": {
            "name": {"type": "string"},
            "type": {"type": "string"}
          }
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "payload", "wire_name"],
          "properties": {
            "name": {"type": "string"},
            "payload": {"type": ["string", "null"]},
            "wire_name": {"type": ["string", "null"]}
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parameters", "return_type", "success_type"],
        "properties": {
          "name": {"type": "string"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": {"type": "string"},
                "type": {"type": "string"}
              }
            }
          },
          "return_type": {"type": "string"},
          "success_type": {"type": "string"},
          "stream": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["item_type", "error_type", "lifetime"],
                "properties": {
                  "item_type": {"type": "string"},
                  "error_type": {"type": "string"},
                  "lifetime": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    },
    "symbol_paths": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "type_preludes"],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type_path",
            "constructor",
            "api_key_builder",
            "base_url_builder"
          ],
          "properties": {
            "type_path": {"type": "string"},
            "constructor": {"type": "string"},
            "api_key_builder": {"type": "string"},
            "base_url_builder": {"type": "string"}
          }
        },
        "type_preludes": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  }
}
