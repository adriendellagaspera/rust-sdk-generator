{
  "openapi": "3.1.0",
  "info": {"title": "Notebook API (independent SDK proof)", "version": "1.0.0"},
  "paths": {
    "/notes/{note_id}": {
      "parameters": [{"name": "note_id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {
        "operationId": "read_note",
        "tags": ["notes"],
        "parameters": [{"name": "verbose", "in": "query", "required": false, "schema": {"type": "boolean"}}],
        "responses": {
          "200": {"description": "note", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}},
          "404": {"description": "missing note", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      },
      "delete": {
        "operationId": "delete_note",
        "tags": ["notes"],
        "responses": {
          "204": {"description": "deleted"},
          "404": {"description": "missing note", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/notes": {
      "post": {
        "operationId": "create_note",
        "tags": ["notes"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewNote"}}}},
        "responses": {
          "201": {"description": "created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}},
          "400": {"description": "invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/notes/{note_id}/export": {
      "parameters": [{"name": "note_id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {
        "operationId": "export_note",
        "tags": ["notes"],
        "responses": {
          "200": {"description": "raw bytes", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
          "404": {"description": "missing note", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewNote": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "subtitle": {"type": ["string", "null"]},
          "priority": {"type": "integer"}
        }
      },
      "Note": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "subtitle": {"type": ["string", "null"]},
          "priority": {"type": "integer"}
        }
      },
      "Problem": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  }
}
