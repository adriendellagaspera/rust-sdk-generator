{
  "openapi": "3.1.0",
  "info": {
    "title": "Manifest-free capability matrix - core",
    "version": "1.0.0"
  },
  "paths": {
    "/widgets/{widget_id}": {
      "post": {
        "operationId": "update_widget",
        "tags": ["fixtures"],
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "schema": {"type": "boolean"}
          },
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/UpdateWidgetRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated widget",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Widget"}
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Problem"}
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_widget",
        "tags": ["fixtures"],
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "204": {"description": "deleted"},
          "404": {
            "description": "missing widget",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Problem"}
              }
            }
          }
        }
      }
    },
    "/text": {
      "get": {
        "operationId": "read_text",
        "tags": ["fixtures"],
        "responses": {
          "200": {
            "description": "plain text",
            "content": {
              "text/plain": {"schema": {"type": "string"}}
            }
          }
        }
      }
    },
    "/blob": {
      "get": {
        "operationId": "download_blob",
        "tags": ["fixtures"],
        "responses": {
          "200": {
            "description": "binary payload",
            "content": {
              "application/octet-stream": {
                "schema": {"type": "string", "format": "binary"}
              }
            }
          },
          "404": {
            "description": "missing blob",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Problem"}
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload_file",
        "tags": ["fixtures"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {"$ref": "#/components/schemas/UploadRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "uploaded widget",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Widget"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateWidgetRequest": {
        "type": "object",
        "required": ["title", "nullable-name"],
        "properties": {
          "title": {"type": "string"},
          "note": {"type": "string"},
          "nullable-name": {"type": ["string", "null"]},
          "tri": {"type": ["string", "null"]}
        }
      },
      "Widget": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"}
        }
      },
      "Problem": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "UploadRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {"type": "string", "format": "binary"},
          "caption": {"type": "string"}
        }
      }
    }
  }
}
