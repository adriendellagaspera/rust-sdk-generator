{
  "openapi": "3.1.0",
  "info": {
    "title": "Unmodified upstream evidence probe",
    "version": "1.0.0"
  },
  "paths": {
    "/inventory": {
      "get": {
        "operationId": "fetchInventoryWithoutNamingShortcut",
        "responses": {
          "200": {
            "description": "Inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          }
        }
      }
    },
    "/render": {
      "post": {
        "operationId": "renderInventory",
        "responses": {
          "200": {
            "description": "Same source operation declares two representations; emitted behavior is authoritative",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "watchInventoryEvents",
        "responses": {
          "200": {
            "description": "SSE-only result",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Inventory": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
