{
  "schema_version": 2,
  "client": {"name": "LibraryClient"},
  "models": {
    "NewBook": {
      "raw": "CreateBookRequest",
      "constructor": ["title"]
    },
    "Book": {
      "raw": "BookResponse",
      "borrowed": false,
      "accessors": {
        "id": {"kind": "ref", "path": ["id"]},
        "title": {"kind": "ref", "path": ["title"]}
      }
    },
    "BookCollection": {
      "raw": "BookList",
      "borrowed": false,
      "accessors": {}
    }
  },
  "resources": {
    "catalog": {
      "name": "Catalog",
      "path": ["catalog"],
      "operations": {}
    },
    "catalog_books": {
      "name": "CatalogBooks",
      "path": ["catalog", "books"],
      "operations": {
        "create": {
          "operation_id": "create_book",
          "request": "NewBook",
          "response": "Book"
        },
        "list": {
          "operation_id": "list_books",
          "response": "BookCollection"
        },
        "delete": {
          "operation_id": "delete_book",
          "empty_response": true
        },
        "download": {
          "operation_id": "download_book",
          "binary_response": true
        }
      }
    }
  }
}
