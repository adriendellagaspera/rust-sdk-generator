{
  "openapi": "3.1.0",
  "info": {
    "title": "Sensor fleet",
    "version": "1"
  },
  "paths": {
    "/chat/completions": {
      "get": {
        "operationId": "complete_chat",
        "responses": {
          "200": {
            "description": "Chat completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "choices": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ChatCompletionChoice"
                }
              }
            },
            "required": [
              "id",
              "model",
              "usage",
              "created",
              "choices"
            ]
          }
        ]
      },
      "ResponseBase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInfo"
          }
        }
      },
      "ChatCompletionChoice": {
        "type": "object",
        "required": [
          "index"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "UsageInfo": {
        "type": "object",
        "required": [
          "total_tokens"
        ],
        "properties": {
          "total_tokens": {
            "type": "integer"
          },
          "service_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
