{
  "openapi": "3.1.0",
  "info": {"title": "Canonical response projection fixture", "version": "1"},
  "paths": {
    "/reports/current": {
      "get": {
        "operationId": "read_report",
        "responses": {
          "200": {
            "description": "report",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/Report"}},
              "application/octet-stream": {"schema": {"type": "string", "format": "binary"}}
            }
          },
          "206": {
            "description": "partial report",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/Report"}}
            }
          }
        }
      }
    },
    "/reports/cache": {
      "delete": {
        "operationId": "purge_reports",
        "responses": {
          "202": {"description": "accepted"},
          "204": {"description": "purged"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Report": {
        "type": "object",
        "required": ["name", "count"],
        "properties": {
          "name": {"type": "string"},
          "count": {"type": "integer"}
        }
      }
    }
  }
}
