{
  "openapi": "3.1.0",
  "info": {"title": "Structured request media fixture", "version": "1"},
  "paths": {
    "/projects/{project_id}/uploads": {
      "post": {
        "operationId": "create_upload",
        "parameters": [
          {"name": "project_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "dry-run", "in": "query", "required": false, "schema": {"type": "boolean"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {"$ref": "#/components/schemas/UploadRequest"}
            }
          }
        },
        "responses": {"204": {"description": "Uploaded"}}
      }
    },
    "/projects/{project_id}/forms": {
      "post": {
        "operationId": "submit_form",
        "parameters": [
          {"name": "project_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "audit", "in": "query", "required": false, "schema": {"type": "boolean"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/FormRequest"}
            }
          }
        },
        "responses": {"204": {"description": "Submitted"}}
      }
    }
  },
  "components": {
    "schemas": {
      "UploadRequest": {
        "type": "object",
        "required": ["labels", "thumbnail", "publish"],
        "properties": {
          "labels": {"type": "array", "items": {"type": "string"}},
          "thumbnail": {"type": "string", "format": "binary"},
          "publish": {"type": "boolean"},
          "file": {
            "anyOf": [
              {"type": "string", "format": "binary"},
              {"type": "null"}
            ]
          },
          "note": {"type": "string"}
        }
      },
      "FormRequest": {
        "type": "object",
        "required": ["title", "tags"],
        "properties": {
          "title": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "integer"}
        }
      }
    }
  }
}
