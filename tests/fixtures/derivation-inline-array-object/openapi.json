{
  "openapi": "3.1.0",
  "info": {"title": "Inline array object fixture", "version": "1"},
  "paths": {
    "/reports/rows": {
      "get": {
        "operationId": "read_rows",
        "responses": {
          "200": {
            "description": "rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "enabled": {"type": "boolean"},
                      "note": {"type": "string"}
                    },
                    "required": ["name", "enabled"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
