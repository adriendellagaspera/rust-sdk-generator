{
  "openapi": "3.1.0",
  "info": {"title": "Inline union response fixture", "version": "1"},
  "paths": {
    "/events/latest": {
      "get": {
        "operationId": "read_latest_event",
        "responses": {
          "200": {
            "description": "latest event",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "message": {"type": "string"}
                      },
                      "required": ["message"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {"type": "integer"},
                        "retryable": {"type": "boolean"}
                      },
                      "required": ["code"]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
