{
  "openapi": "3.1.0",
  "info": {"title": "Request union fixture", "version": "1"},
  "paths": {
    "/tenants/{tenant_id}/commands": {
      "post": {
        "operationId": "send_batch",
        "parameters": [
          {"name": "tenant_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "dry-run", "in": "query", "required": false, "schema": {"type": "boolean"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitBatchRequest"}
            }
          }
        },
        "responses": {
          "204": {"description": "Sent"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitBatchRequest": {
        "type": "object",
        "required": ["label", "commands"],
        "properties": {
          "label": {"type": "string"},
          "commands": {
            "type": "array",
            "items": {
              "oneOf": [
                {"$ref": "#/components/schemas/EmailCommand"},
                {"$ref": "#/components/schemas/SmsCommand"}
              ]
            }
          },
          "note": {"type": "string"}
        }
      },
      "EmailCommand": {
        "type": "object",
        "required": ["address", "subject"],
        "properties": {
          "address": {"type": "string"},
          "subject": {"type": "string"},
          "cc": {"type": "string"}
        }
      },
      "SmsCommand": {
        "type": "object",
        "required": ["number", "message"],
        "properties": {
          "number": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  }
}
