{
  "openapi": "3.1.0",
  "paths": {
    "/lookup": {
      "get": {
        "operationId": "lookup_item",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {"$ref": "#/components/schemas/FoundItem"},
                    {"$ref": "#/components/schemas/MissingItem"}
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FoundItem": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "score": {"type": "number"}
        },
        "required": ["id", "score"]
      },
      "MissingItem": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "retryable": {"type": "boolean"}
        },
        "required": ["query", "retryable"]
      }
    }
  }
}
