{
  "openapi": "3.1.0",
  "info": {"title": "Catalog metadata", "version": "1"},
  "paths": {
    "/catalog/tags": {
      "get": {
        "operationId": "read_tags",
        "responses": {"200": {"description": "Tags", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TagList"}}}}}
      }
    },
    "/catalog/labels": {
      "get": {
        "operationId": "read_labels",
        "responses": {"200": {"description": "Labels", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LabelMap"}}}}}
      }
    },
    "/catalog/mode": {
      "get": {
        "operationId": "read_mode",
        "responses": {"200": {"description": "Mode", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunMode"}}}}}
      }
    }
  },
  "components": {
    "schemas": {
      "TagList": {
        "type": "array",
        "items": {"type": "string"}
      },
      "LabelMap": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      },
      "RunMode": {
        "type": "string",
        "enum": ["fast", "safe"]
      }
    }
  }
}
